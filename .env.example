# App
STTD_APP_ENV=development
STTD_APP_SHUTDOWN_TIMEOUT=5s

# Platform
STTD_PLATFORM_PROFILE=auto

# Trigger
# Optional override:
# STTD_TRIGGER_SOURCE=stub
STTD_TRIGGER_DOUBLE_TAP_WINDOW=400ms
STTD_TRIGGER_HOTKEY_MODIFIERS=cmd+shift
STTD_TRIGGER_HOTKEY_KEY=space
# Steam Deck / Linux evdev trigger
STTD_TRIGGER_DEVICE_PATH=
STTD_TRIGGER_EVENT_TYPE=0
STTD_TRIGGER_EVENT_CODE=0
STTD_TRIGGER_ACTIVE_VALUE=1

# Audio
STTD_AUDIO_TEMP_DIR=/tmp/sttd
STTD_AUDIO_FILE_NAME=last-recording.wav
STTD_AUDIO_SAMPLE_FORMAT=wav
STTD_AUDIO_INPUT_DEVICE=

# Transcription
STTD_TRANSCRIBE_BINARY_PATH=/usr/local/bin/whisper-cli
STTD_TRANSCRIBE_MODEL_PATH=/path/to/ggml-base.bin
# Leave empty to let whisper auto-detect language when using a multilingual model.
STTD_TRANSCRIBE_LANGUAGE=auto
STTD_TRANSCRIBE_TIMEOUT=10s

# Clipboard
STTD_CLIPBOARD_ENABLE_PASTE=true

# Notifications
STTD_NOTIFY_ENABLED=false
