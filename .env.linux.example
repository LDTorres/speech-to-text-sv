# Platform
STTD_PLATFORM_PROFILE=linux
STTD_PLATFORM_INTEGRATION=
STTD_PUBLIC_COMMAND_NAME=listen
STTD_HYPRLAND_CONFIG_PATH=
STTD_HYPRLAND_BINDING=$mainMod ALT, SPACE

# Trigger
STTD_TRIGGER_HOTKEY_MODIFIERS=ctrl+shift
STTD_TRIGGER_HOTKEY_KEY=space
STTD_TRIGGER_DOUBLE_TAP_WINDOW=400ms

# External control
STTD_EXTERNAL_CONTROL_ENABLED=false
STTD_EXTERNAL_CONTROL_SOCKET_PATH=

# Audio
STTD_AUDIO_TEMP_DIR=/tmp/sttd
STTD_AUDIO_FILE_NAME=last-recording.wav
STTD_AUDIO_INPUT_DEVICE=
# Automatically wakes a composite USB webcam only when its audio node has no frames.
STTD_AUDIO_CAMERA_WAKE=auto
STTD_AUDIO_CAMERA_VIDEO_DEVICE=

# Transcription
STTD_TRANSCRIBE_BINARY_PATH=/usr/local/bin/whisper-cli
STTD_TRANSCRIBE_ACCELERATION=auto
STTD_TRANSCRIBE_MODEL_PATH=/path/to/ggml-base.bin
STTD_TRANSCRIBE_LANGUAGE=es
STTD_TRANSCRIBE_TIMEOUT=10s

# Pinned model source and verified SHA-256 values
STTD_MODEL_REVISION=362722b3fdcd2300b58a8286933ead1c48619667
STTD_MODEL_SHA256_TINY=be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21
STTD_MODEL_SHA256_BASE=60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe
STTD_MODEL_SHA256_SMALL=1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b
STTD_MODEL_SHA256_LARGE=64d182b440b98d5203c4f9bd541544d84c605196c4f7b845dfa11fb23594d1e2

# Clipboard
STTD_CLIPBOARD_ENABLE_PASTE=true
STTD_CLIPBOARD_TIMEOUT=5s
