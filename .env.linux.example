# Platform
STTD_PLATFORM_PROFILE=linux
STTD_PLATFORM_INTEGRATION=

# Trigger
STTD_TRIGGER_HOTKEY_MODIFIERS=ctrl+shift
STTD_TRIGGER_HOTKEY_KEY=space
STTD_TRIGGER_DOUBLE_TAP_WINDOW=400ms

# External control
STTD_EXTERNAL_CONTROL_ENABLED=false
STTD_EXTERNAL_CONTROL_SOCKET_PATH=

# Audio
STTD_AUDIO_TEMP_DIR=/tmp/sttd
STTD_AUDIO_FILE_NAME=last-recording.wav
STTD_AUDIO_INPUT_DEVICE=

# Transcription
STTD_TRANSCRIBE_BINARY_PATH=/usr/local/bin/whisper-cli
STTD_TRANSCRIBE_MODEL_PATH=/path/to/ggml-base.bin
STTD_TRANSCRIBE_LANGUAGE=es
STTD_TRANSCRIBE_TIMEOUT=10s

# Model source (use an immutable Hugging Face revision and optional SHA-256 values for reproducible installs)
STTD_MODEL_REVISION=main
STTD_MODEL_SHA256_TINY=
STTD_MODEL_SHA256_BASE=
STTD_MODEL_SHA256_SMALL=

# Clipboard
STTD_CLIPBOARD_ENABLE_PASTE=true
STTD_CLIPBOARD_TIMEOUT=5s
