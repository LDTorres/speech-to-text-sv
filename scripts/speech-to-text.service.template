[Unit]
Description=Speech to Text Daemon
After=default.target

[Service]
Type=simple
WorkingDirectory=__WORKING_DIRECTORY__
EnvironmentFile=__ENV_FILE__
ExecStart=__EXEC_START__
StandardOutput=append:%h/.local/state/sttd/sttd.log
StandardError=append:%h/.local/state/sttd/sttd.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
